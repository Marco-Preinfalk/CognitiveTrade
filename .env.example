# AI Trading Bot Configuration
# Copy to .env and fill in your values:
#   cp .env.example .env

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral:latest
OLLAMA_TEMPERATURE=0.3

# Trading mode: CRYPTO, STOCKS, or HYBRID
TRADING_MODE=STOCKS

# Portfolio
INITIAL_BALANCE=10000
RISK_PER_TRADE=2.0
MAX_POSITIONS=5

# Slippage and fees (simulated)
SLIPPAGE_PERCENT=0.05
COMMISSION_PER_TRADE=0.10

# Telegram (optional)
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# Backtesting
BACKTEST_DAYS=60
BACKTEST_INTERVAL=1h

# System
DEBUG_MODE=True
LOG_LEVEL=INFO

# Finnhub news API (free: https://finnhub.io/register)
FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY

# Alpaca paper trading (optional, free: https://alpaca.markets)
ALPACA_ENABLED=False
ALPACA_PAPER=True
ALPACA_API_KEY=YOUR_ALPACA_API_KEY
ALPACA_SECRET_KEY=YOUR_ALPACA_SECRET_KEY
